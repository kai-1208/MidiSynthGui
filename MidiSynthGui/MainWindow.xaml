<Window x:Class="MidiSynthGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Low-Latency MIDI Piano Synth" Height="480" Width="550"
        Background="#1E1E1E" Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock Grid.Row="0" Text="🎹 Low-Latency SoundFont Synth" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- 1. SoundFont 選択 -->
        <GroupBox Grid.Row="1" Header="SoundFont (.sf2)" Foreground="#AAAAAA" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSoundFontPath" Grid.Column="0" IsReadOnly="True" Background="#2D2D30" Foreground="#FFFFFF" Padding="5" VerticalContentAlignment="Center"/>
                <Button x:Name="BtnBrowseSf2" Grid.Column="1" Content="参照..." Width="80" Margin="10,0,0,0" Click="BtnBrowseSf2_Click" Background="#007ACC" Foreground="White"/>
            </Grid>
        </GroupBox>

        <!-- 2. MIDI & オーディオ設定 -->
        <GroupBox Grid.Row="2" Header="デバイス設定" Foreground="#AAAAAA" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="MIDI 入力:" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbMidiPorts" Grid.Row="0" Grid.Column="1" SelectionChanged="CmbMidiPorts_SelectionChanged"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="オーディオ出力:" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbAudioDevices" Grid.Row="2" Grid.Column="1" SelectionChanged="CmbAudioDevices_SelectionChanged"/>
            </Grid>
        </GroupBox>

        <!-- 3. コントロール (音量・ペダル・Panic) -->
        <GroupBox Grid.Row="3" Header="演奏コントロール" Foreground="#AAAAAA" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <!-- 音量 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="マスター音量:" VerticalAlignment="Center"/>
                <Slider x:Name="SldVolume" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="100" ValueChanged="SldVolume_ValueChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtVolumeVal" Grid.Row="0" Grid.Column="2" Text="100%" TextAlignment="Right" VerticalAlignment="Center"/>

                <!-- ペダル & Panic -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="ChkPedal" Content="サステインペダルを有効化" IsChecked="True" Checked="ChkPedal_Changed" Unchecked="ChkPedal_Changed" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button x:Name="BtnPanic" Content="全音停止" Click="BtnPanic_Click" Padding="10,5" Background="#D9534F" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ステータスバー -->
        <StatusBar Grid.Row="6" Background="#007ACC" Foreground="White" Padding="5">
            <TextBlock x:Name="TxtStatus" Text="準備完了"/>
        </StatusBar>
    </Grid>
</Window>